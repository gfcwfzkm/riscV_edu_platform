\logisimfontB{\fontsize{12pt}{12pt}\selectfont\node[inner sep=0, outer sep=0, custcol_FFFF00, anchor=base west] at (32,122) {cpuInstr};}
\logisimfontB{\fontsize{12pt}{12pt}\selectfont\node[inner sep=0, outer sep=0, custcol_FFFF00, anchor=base west] at (22,139) {Priority: 2};}
\fill [line width=1pt, custcol_000000] (110,128) rectangle (130,132);
