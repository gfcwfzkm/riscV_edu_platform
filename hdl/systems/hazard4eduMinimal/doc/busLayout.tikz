\logisimfontB{\fontsize{12pt}{12pt}\selectfont\node[inner sep=0, outer sep=0, custcol_FFFF00, anchor=base west] at (209,69) {64 kbytes};}
\fill [line width=1pt, custcol_000000] (130,43) rectangle (150,47);
\fill [line width=1pt, custcol_808080] (150,90) rectangle (330,160);
