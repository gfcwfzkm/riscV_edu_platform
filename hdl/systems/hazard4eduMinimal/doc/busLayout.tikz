\begin{tikzpicture}[x=1pt,y=-1pt,line cap=rect]
\def\logisimfontA#1{\textsf{#1}}
\def\logisimfontB#1{\texttt{#1}}
\definecolor{custcol_FFFFFF}{HTML}{FFFFFF}
