\logisimfontB{\fontsize{12pt}{12pt}\selectfont\node[inner sep=0, outer sep=0, custcol_FFFF00, anchor=base west] at (22,89) {Priority: 1};}
\fill [line width=1pt, custcol_000000] (110,78) rectangle (130,82);
\fill [line width=1pt, custcol_0000FF] (10,110) rectangle (110,150);
