# GECKO5Education pin constraints for the hazard4eduMinimal SoC
# (subset of hdl/systems/debugSystem/scripts/gecko5.lpf)

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

LOCATE COMP "clock" SITE "F1";
IOBUF  PORT "clock" PULLMODE=NONE IO_TYPE=LVCMOS33;
FREQUENCY PORT "clock" 50 MHZ;

LOCATE COMP "n_reset" SITE "G1";
IOBUF  PORT "n_reset" PULLMODE=UP IO_TYPE=LVCMOS33;

LOCATE COMP "RxD" SITE "T1";
LOCATE COMP "TxD" SITE "R1";
IOBUF PORT "RxD" PULLMODE=NONE IO_TYPE=LVCMOS33;
IOBUF PORT "TxD" PULLMODE=NONE IO_TYPE=LVCMOS33;
