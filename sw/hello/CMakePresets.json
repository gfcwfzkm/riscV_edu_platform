{
  "version": 3,
  "configurePresets": [
    {
      "name": "rv32im",
      "displayName": "hazard4eduMinimal RV32IM (auto: GCC if found, else clang)",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "${sourceDir}/cmake/riscv-rv32im.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "rv32im-clang",
      "inherits": "rv32im",
      "displayName": "hazard4eduMinimal RV32IM (clang + ld.lld)",
      "cacheVariables": { "RISCV_TOOLCHAIN": "clang" }
    },
    {
      "name": "rv32im-gcc",
      "inherits": "rv32im",
      "displayName": "hazard4eduMinimal RV32IM (riscv*-elf-gcc)",
      "cacheVariables": { "RISCV_TOOLCHAIN": "gcc" }
    }
  ],
  "buildPresets": [
    { "name": "rv32im", "configurePreset": "rv32im" },
    { "name": "rv32im-clang", "configurePreset": "rv32im-clang" },
    { "name": "rv32im-gcc", "configurePreset": "rv32im-gcc" }
  ]
}
