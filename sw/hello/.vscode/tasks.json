{
  // Open the folder sw/hello in VS Code. OpenOCD is started through the SoC's Makefile, which
  // finds the OSS CAD Suite in /opt/oss-cad-suite (or OSS_CAD_SUITE) and selects the GECKO5's FT2232H.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake configure",
      "type": "shell",
      "command": "cmake --preset rv32im",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "test -f build/CMakeCache.txt || cmake --preset rv32im; cmake --build build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run on board (JTAG load + start)",
      "type": "shell",
      "command": "make -C ${workspaceFolder}/../../hdl/systems/hazard4eduMinimal run ELF=${workspaceFolder}/build/hello.elf",
      "dependsOn": "build",
      "problemMatcher": []
    },
    {
      "label": "load bitstream (FPGA SRAM)",
      "type": "shell",
      "command": "make -C ${workspaceFolder}/../../hdl/systems/hazard4eduMinimal load",
      "problemMatcher": []
    },
    {
      // Background task for the "Hazard3 (OpenOCD + gdb)" launch configuration: VS Code waits until
      // OpenOCD listens for gdb, then starts the debugger.
      "label": "openocd",
      "type": "shell",
      // An OpenOCD left over from an earlier session (e.g. one that failed to start, so the
      // postDebugTask never ran) holds the ports and the JTAG adapter: stop it first
      "command": "pkill -TERM -f '[o]penocd -f openocd/gecko5-hazard3.cfg'; sleep 1; make -C ${workspaceFolder}/../../hdl/systems/hazard4eduMinimal openocd",
      "dependsOn": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "openocd",
        "pattern": { "regexp": "^(Error):\\s+(.*)$", "severity": 1, "message": 2 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Open On-Chip Debugger",
          "endsPattern": "Listening on port 3333 for gdb connections"
        }
      }
    },
    {
      // The board's UART in minicom (115200 8N1), in its own terminal tab. Quit with Ctrl+A X;
      // the port can be changed with UART_DEV, see the SoC's Makefile.
      "label": "uart console",
      "type": "shell",
      "command": "make -s --no-print-directory -C ${workspaceFolder}/../../hdl/systems/hazard4eduMinimal console",
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true, "echo": false },
      "problemMatcher": []
    },
    {
      "label": "stop openocd",
      "type": "shell",
      "command": "pkill -TERM -f '[o]penocd -f openocd/gecko5-hazard3.cfg' || true",
      "problemMatcher": []
    },
    // ---------------------------------------------------------------- Release (-O2, build-release/)
    {
      "label": "build (release)",
      "type": "shell",
      "command": "test -f build-release/CMakeCache.txt || cmake --preset rv32im-release; cmake --build build-release",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "run on board (release, JTAG load + start)",
      "type": "shell",
      "command": "make -C ${workspaceFolder}/../../hdl/systems/hazard4eduMinimal run ELF=${workspaceFolder}/build-release/hello.elf",
      "dependsOn": "build (release)",
      "problemMatcher": []
    },
    {
      // Same as "openocd", but builds the Release program first
      "label": "openocd (release)",
      "type": "shell",
      // An OpenOCD left over from an earlier session (e.g. one that failed to start, so the
      // postDebugTask never ran) holds the ports and the JTAG adapter: stop it first
      "command": "pkill -TERM -f '[o]penocd -f openocd/gecko5-hazard3.cfg'; sleep 1; make -C ${workspaceFolder}/../../hdl/systems/hazard4eduMinimal openocd",
      "dependsOn": "build (release)",
      "isBackground": true,
      "problemMatcher": {
        "owner": "openocd",
        "pattern": { "regexp": "^(Error):\\s+(.*)$", "severity": 1, "message": 2 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Open On-Chip Debugger",
          "endsPattern": "Listening on port 3333 for gdb connections"
        }
      }
    }
  ]
}
